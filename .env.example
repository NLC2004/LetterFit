# 复制为 .env 后填写。不要把填好的 .env 发给别人。
# 也可以不改这个文件：首次启动会进入配置向导，填完自动写入 .env。

# ----- 大模型（OpenAI 兼容接口）-----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ----- 发信邮箱（SMTP）-----
# SMTP_PASSWORD 填你的邮箱密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
