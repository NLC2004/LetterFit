# 复制为 .env 后填写。不要把填好的 .env 发给别人。
# 也可以不改这个文件：首次启动程序会进入配置向导，填完自动写入 .env。

# ----- 大模型（OpenAI 兼容接口）-----
# DeepSeek: https://api.deepseek.com （新用户有免费额度，推荐）
# 月之暗面 Kimi: https://api.moonshot.cn/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ----- 发信邮箱（SMTP）-----
# SMTP_PASSWORD 填你的邮箱密码。
# 常见配置：
#   QQ 邮箱    smtp.qq.com            465  SSL
#   163 邮箱   smtp.163.com           465  SSL
#   Outlook    smtp.office365.com     587  SMTP_SSL=false（STARTTLS）
#   校园邮箱   见学校信息化处页面说明
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
